# Copy to .env for local development.  NEVER commit .env.
DATABASE_URL=postgresql://vault:vault@localhost:5432/vault
PUBLIC_BASE_URL=http://localhost:8000
AUTH_MODE=none

# --- for AUTH_MODE=github (production) ---
# GITHUB_CLIENT_ID=Ov23li...
# GITHUB_CLIENT_SECRET=...
# JWT_SIGNING_KEY=        # python -c "import secrets;print(secrets.token_urlsafe(48))"
# STORAGE_ENCRYPTION_KEY= # same command, a different value

# --- search ---
EMBEDDINGS=none           # or: fastembed  (pip install -e ".[embeddings]")
SEMANTIC_MIN_SIMILARITY=0.55

# --- protect your free quotas ---
MAX_MEMORIES_PER_USER=5000
MAX_CONTENT_CHARS=4000
RATE_LIMIT_RPS=5
